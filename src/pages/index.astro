---
// The area between the two "---" lines is the "frontmatter".
// Code here runs once, when Astro builds the site, not in the visitor's browser.
// It's empty for now. In Phase 1 this is where we'll load src/content.json.
---

<!--
  Everything below is the page itself, written as HTML.
  Because this file is at src/pages/index.astro, Astro turns it into the
  home page (index.html) of the site.
  This is a Phase 0 placeholder. Phase 1 replaces it with the real design.
-->
<html lang="en">
	<!-- lang="en" tells browsers and screen readers the page is in English. -->
	<head>
		<!-- The <head> holds information about the page. None of it shows on screen. -->

		<!-- Use the UTF-8 character set, so every letter and symbol displays correctly. -->
		<meta charset="utf-8" />

		<!-- The small icon in the browser tab. The files live in public/. -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<!-- On phones, fit the page to the screen width instead of zooming out. -->
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- The text in the browser tab and in search results. -->
		<title>Isaac Hii Nian Hong</title>

		<style>
			/* CSS: the rules that control how the page looks. */
			body {
				margin: 0; /* remove the browser's default gap around the page */
				min-height: 100vh; /* at least as tall as the screen (vh = viewport height) */
				display: grid; /* lay out the content with CSS grid... */
				place-items: center; /* ...so it can be centred both ways */
				background: #0d0d0d; /* near-black, same as --bg in the PRD */
				color: #ededed; /* off-white text, same as --text in the PRD */
				font-family: ui-monospace, Menlo, monospace; /* a terminal-style font */
			}
		</style>
	</head>
	<body>
		<!-- The <body> is what visitors actually see. -->
		<p>~/isaac-hii $ whoami · coming soon</p>
	</body>
</html>
