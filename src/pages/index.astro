---
// The area between the two "---" lines is the "frontmatter".
// Code here runs once, when Astro builds the site, not in the visitor's browser.

// Load the fonts. Fontsource ships the font files with the site, so visitors
// don't download them from Google. One import per weight we use.
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';

// Load all the site's styles.
import '../styles/global.css';

// Load all the text. "content" is now an object, so content.hero.name
// gives "Isaac Hii Nian Hong." from src/content.json.
import content from '../content.json';

// Pull each part out of content into its own short name.
const { site, links, nav, hero, about, experience, research, hackathons, learning, contact, footer } = content;

// ATGC background: build the grid of random DNA letters once, at build time.
// Because this runs in the frontmatter, the letters are already written into
// the HTML file. The visitor's browser runs no script to make them.
// 80 rows of 200 letters is enough to fill a large 2560 × 1600 screen. On
// smaller screens the extra letters are just cut off (see .atgc in global.css).
// Array.from({ length: n }, fn) makes a list of n items by calling fn n times.
const atgcRows = Array.from({ length: 80 }, () =>
	Array.from({ length: 200 }, () => 'ACGT'[Math.floor(Math.random() * 4)]).join('')
);
// Join the rows with line breaks into one block of text.
const atgcGrid = atgcRows.join('\n');

// Random patches: the letters only show in a few soft "clouds" and fade to
// nothing between them. Each cloud is a radial gradient (solid in the middle,
// fading to transparent at its edge) at a random place, also picked at build
// time. Stacked together they make a mask: letters show only inside a cloud.
// Percentages are of the window's size, so the clouds scale with the window.
const rand = (min, max) => Math.round(min + Math.random() * (max - min));
// Each patch is { x, y, w, h }: its centre (x across, y down) and its
// half-width and half-height, all as percentages of the window.
const atgcPatches = Array.from({ length: 8 }, () => ({
	x: rand(0, 100),
	y: rand(0, 100),
	w: rand(15, 30),
	h: rand(20, 35),
}));
// Turn each patch into a CSS gradient, and write the list as a CSS variable
// (--patches) on the elements, so global.css can use it as a mask.
const atgcPatchStyle =
	'--patches: ' +
	atgcPatches
		.map((p) => `radial-gradient(ellipse ${p.w}% ${p.h}% at ${p.x}% ${p.y}%, #000 0%, rgba(0, 0, 0, 0.6) 40%, transparent 100%)`)
		.join(', ');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<!-- Curly braces { } insert a value from the frontmatter into the HTML. -->
		<title>{site.title}</title>
		<meta name="description" content={site.description} />
	</head>
	<body>
		<!--
			===== ATGC background =====
			The grid of DNA letters behind the whole page. It's decoration, so
			aria-hidden="true" tells screen readers to skip it completely.
			Otherwise VoiceOver would read out 16,000 letters.
			Two layers, each with its own mask: the outer one keeps the middle of
			the window faint, the inner one cuts the letters into random patches.
		-->
		<div class="atgc" aria-hidden="true">
			<div class="atgc-patches" style={atgcPatchStyle}>{atgcGrid}</div>
		</div>
		<!--
			Background glitches: an empty layer on top of the grid. The script in
			src/scripts/atgc-glitches.js fills it with short-lived glitches.
			It gets the same patch mask, plus the patch list as data-patches
			(a data-* attribute is a place to hand values from HTML to a script),
			so the script can put glitches inside the patches.
		-->
		<div class="atgc-glitches" aria-hidden="true" style={atgcPatchStyle} data-patches={JSON.stringify(atgcPatches)}></div>
		<!--
			Astro bundles a <script> like this one and loads it in the browser.
			This is the only script on the page.
		-->
		<script>
			import '../scripts/atgc-glitches.js';
		</script>

		<!-- ===== Navigation bar ===== -->
		<header class="nav">
			<div class="nav-bar">
				<a href="#top" class="nav-logo">{site.logo}</a>
				<nav aria-label="Main" class="nav-links">
					<!--
						nav.map(...) loops over the list of links in content.json
						and makes one <a> for each, so adding a link there adds it here.
					-->
					{nav.map((item) => (
						<a href={item.href} class="nav-link">{item.label}</a>
					))}
					<a href={links.github} class="btn btn-outline">GitHub</a>
					<a href="#contact" class="btn btn-solid">
						Get in touch
						<!-- The small ↗ arrow. aria-hidden hides it from screen readers, since it's decoration. -->
						<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg>
					</a>
				</nav>
			</div>
		</header>

		<!-- ===== Hero ===== -->
		<div class="hero-wrap">
			<section id="top" class="hero">
				<div class="hero-content">
					<p class="prompt-pill">
						{hero.prompt}<span class="cursor" aria-hidden="true"></span>
					</p>
					<!--
						Name glitch: .gname wraps the real name, which screen readers read.
						.gname-glitch is an empty layer on top of it. Its ::before and
						::after (see global.css) draw two copies of the name, copied from
						data-text, that flash during the glitch. aria-hidden="true" hides
						the layer and its copies, so VoiceOver reads the name only once.
					-->
					<h1>
						<span class="gname">{hero.name}<span class="gname-glitch" aria-hidden="true" data-text={hero.name}></span></span><br /><span class="grey">{hero.tagline}</span>
					</h1>
					<p class="hero-intro">{hero.intro}</p>
					<div class="button-row">
						<!-- The CV link points to #contact until the PDF is added in Phase 5. -->
						<a href={links.cv} class="btn btn-solid">
							Download CV
							<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg>
						</a>
						<a href={links.linkedin} class="btn btn-outline">
							LinkedIn
							<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg>
						</a>
					</div>
				</div>
			</section>
		</div>

		<!-- <main> marks the page's main content, which helps screen readers. -->
		<main class="main">
			<!-- ===== A bit about me ===== -->
			<!-- aria-labelledby links the section to its heading, so screen readers can name it. -->
			<section class="section" aria-labelledby="about-h">
				<h2 id="about-h">{about.heading}</h2>
				<div class="card">
					<!-- One row: the paragraph, then the facts underneath it. -->
					<div class="row about-row">
						<p class="about-text">{about.paragraph}</p>
						<!-- <dl> is a "description list": pairs of a label (<dt>) and a value (<dd>). -->
						<dl class="facts">
							{about.facts.map((fact) => (
								<div>
									<dt class="mono-label">{fact.label}</dt>
									<dd>{fact.value}</dd>
								</div>
							))}
						</dl>
					</div>
				</div>
			</section>

			<!-- ===== Experience ===== -->
			<section id="experience" class="section" aria-labelledby="exp-h">
				<h2 id="exp-h">{experience.heading}<br /><span class="grey">{experience.subheading}</span></h2>
				<!-- <ol> is an ordered list, one <li> per role. -->
				<ol class="card">
					{experience.entries.map((entry) => (
						<li class="row entry">
							<p class="mono-label">{entry.when}</p>
							<h3 class="entry-title">{entry.title}</h3>
							<p class="entry-detail">{entry.detail}</p>
						</li>
					))}
				</ol>
			</section>

			<!-- ===== Research and skills ===== -->
			<section id="research" class="section" aria-labelledby="res-h">
				<h2 id="res-h">{research.heading}</h2>
				<div class="card">
					<div class="row entry">
						<p class="mono-label">{research.poster.label}</p>
						<h3 class="entry-title">{research.poster.title}</h3>
						<p class="entry-detail">{research.poster.venue}</p>
					</div>
					<div class="row terminal">
						<p class="mono-label">{research.skillsPrompt}</p>
						{research.skills.map((skill) => (
							<p class="term-line"><span class="key">{skill.label}</span><span>{skill.value}</span></p>
						))}
					</div>
				</div>
			</section>

			<!-- ===== Hackathons ===== -->
			<section id="hackathons" class="section" aria-labelledby="hack-h">
				<h2 id="hack-h">{hackathons.heading}<br /><span class="grey">{hackathons.subheading}</span></h2>
				<div class="card">
					{hackathons.entries.map((entry) => (
						<div class="row">
							<p class="mono-label">{entry.path}</p>
							<h3 class="entry-title">{entry.title}</h3>
							<p class="entry-detail">{entry.text}</p>
						</div>
					))}
					<!-- The "next" row is dimmer, and "hear from you" links to the contact card. -->
					<div class="row">
						<p class="mono-label faint">{hackathons.next.path}</p>
						<p class="entry-detail">
							{hackathons.next.textBefore}<a href="#contact">{hackathons.next.linkText}</a>{hackathons.next.textAfter}
						</p>
					</div>
				</div>
			</section>

			<!-- ===== Learning data science ===== -->
			<section id="learning" class="section" aria-labelledby="learn-h">
				<h2 id="learn-h">{learning.heading}<br /><span class="grey">{learning.subheading}</span></h2>
				<div class="card log">
					<p class="mono-label log-header">{learning.prompt}</p>
					<div class="terminal">
						<!--
							Each log line gets a tag like [now] or [done].
							"now" tags are white; whole "done" lines are grey.
						-->
						{learning.log.map((line) => (
							<p class={line.tag === 'done' ? 'term-line line-done' : 'term-line'}>
								<span class={`key tag-${line.tag}`}>[{line.tag}]</span><span>{line.text}</span>
							</p>
						))}
					</div>
				</div>
			</section>

			<!-- ===== Contact ===== -->
			<section id="contact" class="contact" aria-labelledby="contact-h">
				<h2 id="contact-h">{contact.heading}<br /><span class="grey">{contact.subheading}</span></h2>
				<p class="contact-text">{contact.text}</p>
				<div class="button-row">
					<!-- Phase 5 adds the script that fills in the hidden email address. -->
					<a href="#contact" class="btn btn-solid" id="email-button">
						Email me
						<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg>
					</a>
					<a href={links.linkedin} class="btn btn-outline">
						LinkedIn
						<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"></path></svg>
					</a>
				</div>
			</section>

			<!-- ===== Footer ===== -->
			<footer class="footer">
				<p>{footer.left}</p>
				<!-- Right side: my first line of Python as a quiet signature, then the mono line. -->
				<div class="footer-right">
					<p class="mono">{footer.firstCode}</p>
					<p class="mono">{footer.right}</p>
				</div>
			</footer>
		</main>
	</body>
</html>
